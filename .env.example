# Copy this to .env and fill in your values
# Dev mode: only BRAIN_PATH and OLLAMA_HOST are required
# Production: all vars required

ANTHROPIC_API_KEY=        # optional in dev, required in prod
GOOGLE_API_KEY=           # for Imagen image generation
SHOPIFY_ACCESS_TOKEN=     # shpat_... from your Shopify custom app
SHOPIFY_STORE_URL=        # yourstore.myshopify.com

# Printify — used for mockup generation (not publishing)
PRINTIFY_API_TOKEN=       # from printify.com → account → API tokens
PRINTIFY_SHOP_ID=         # numeric ID from printify.com dashboard URL
PRINTIFY_BLUEPRINT_ID=6   # default: Bella+Canvas 3001 unisex tee
PRINTIFY_PRINT_PROVIDER=29 # default: Monster Digital (US)

BRAIN_PATH=./brain        # path to brain folder
OLLAMA_HOST=http://localhost:11434

# Printify → Etsy
PRINTIFY_ETSY_SHOP_ID=    # Printify's ID for the connected Etsy shop

# Etsy API (market research, listing updates)
ETSY_API_KEY=
ETSY_SHARED_SECRET=
ETSY_SHOP_ID=
ETSY_SHOP_NAME=
ETSY_ACCESS_TOKEN=        # filled in by the /etsy/auth OAuth flow
ETSY_REFRESH_TOKEN=
ETSY_TOKEN_EXPIRES_AT=
ETSY_PRODUCTION_PARTNER_ID=

# Notifications
OWNER_PHONE=              # WhatsApp number for approvals and briefings, digits only (e.g. 15551234567)

# Optional
PUBLER_API_KEY=           # Media Bay social scheduling
EVERBEE_CLIENT_ID=
EVERBEE_CLIENT_SECRET=
